<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Genocs.Notifications.WebApi</RootNamespace>
        <AssemblyName>Genocs.Notifications.WebApi</AssemblyName>
        <IsPackable>false</IsPackable>
        <UserSecretsId>Genocs</UserSecretsId>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <DockerfileContext>..\..</DockerfileContext>
        <!-- Disable web.config transformation for Docker builds -->
        <TransformWebConfigEnabled>false</TransformWebConfigEnabled>
        <WebConfigTransformEnabled>false</WebConfigTransformEnabled>
        <SignalRClientProjectDir>$(MSBuildProjectDirectory)\signalr-client</SignalRClientProjectDir>
        <EnableSignalRClientBuild Condition="'$(EnableSignalRClientBuild)' == ''">true</EnableSignalRClientBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Azure.Messaging.EventHubs" Version="5.12.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Auth\Auth.csproj" />
        <ProjectReference Include="..\..\..\Http\Http.csproj" />
        <ProjectReference Include="..\..\..\LoadBalancing.Fabio\LoadBalancing.Fabio.csproj" />
        <ProjectReference Include="..\..\..\Logging\Logging.csproj" />
        <ProjectReference Include="..\..\..\Messaging.Outbox.MongoDB\Messaging.Outbox.MongoDB.csproj" />
        <ProjectReference Include="..\..\..\Messaging.Outbox\Messaging.Outbox.csproj" />
        <ProjectReference Include="..\..\..\Messaging.RabbitMQ\Messaging.RabbitMQ.csproj" />
        <ProjectReference Include="..\..\..\Messaging\Messaging.csproj" />
        <ProjectReference Include="..\..\..\Persistence.MongoDB\Persistence.MongoDB.csproj" />
        <ProjectReference Include="..\..\..\Persistence.Redis\Persistence.Redis.csproj" />
        <ProjectReference Include="..\..\..\Secrets.HashicorpKeyVault\Secrets.HashicorpKeyVault.csproj" />
        <ProjectReference Include="..\..\..\Telemetry\Telemetry.csproj" />
        <ProjectReference Include="..\..\..\WebApi.CQRS\WebApi.CQRS.csproj" />
        <ProjectReference Include="..\..\..\WebApi.OpenApi\WebApi.OpenApi.csproj" />
        <ProjectReference Include="..\..\..\WebApi.Security\WebApi.Security.csproj" />
        <ProjectReference Include="..\..\..\WebApi\WebApi.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="certs\**" CopyToPublishDirectory="Always" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="logs\" />
    </ItemGroup>

    <Target Name="BuildSignalRClient" BeforeTargets="Build;Publish" Condition="'$(EnableSignalRClientBuild)' == 'true' and Exists('$(SignalRClientProjectDir)\package.json')">
        <Message Text="Building SignalR React client..." Importance="high" />
        <Exec Command="npm ci" WorkingDirectory="$(SignalRClientProjectDir)" Condition="Exists('$(SignalRClientProjectDir)\package-lock.json')" />
        <Exec Command="npm install" WorkingDirectory="$(SignalRClientProjectDir)" Condition="!Exists('$(SignalRClientProjectDir)\package-lock.json')" />
        <Exec Command="npm run build" WorkingDirectory="$(SignalRClientProjectDir)" />
    </Target>
</Project>