        <ProjectReference Include="..\..\..\Messaging.RabbitMQ\Messaging.RabbitMQ.csproj" />
        <ProjectReference Include="..\..\..\Messaging\Messaging.csproj" />
        <ProjectReference Include="..\..\..\Persistence.EFCore.MultiTenancy.SqlServer\Persistence.EFCore.MultiTenancy.SqlServer.csproj" />
        <ProjectReference Include="..\..\..\Saga.Integrations.MongoDB\Saga.Integrations.MongoDB.csproj" />
        <ProjectReference Include="..\..\..\Saga.Integrations.Redis\Saga.Integrations.Redis.csproj" />
        <ProjectReference Include="..\..\..\Saga\Saga.csproj" />
        <ProjectReference Include="..\..\..\Telemetry\Telemetry.csproj" />
