<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Genocs.Library.Demo.Masstransit.WebApi</RootNamespace>
        <AssemblyName>Genocs.Library.Demo.Masstransit.WebApi</AssemblyName>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>Genocs</UserSecretsId>
        <IsPackable>false</IsPackable>
        <!-- Disable web.config transformation for Docker builds -->
        <TransformWebConfigEnabled>false</TransformWebConfigEnabled>
        <WebConfigTransformEnabled>false</WebConfigTransformEnabled>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MassTransit.RabbitMQ" Version="[8.5.8]" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Auth\Auth.csproj" />
        <ProjectReference Include="..\..\..\Http\Http.csproj" />
        <ProjectReference Include="..\..\..\Logging\Logging.csproj" />
        <ProjectReference Include="..\..\..\Messaging.RabbitMQ\Messaging.RabbitMQ.csproj" />
        <ProjectReference Include="..\..\..\Persistence.EFCore.MultiTenancy.SqlServer\Persistence.EFCore.MultiTenancy.SqlServer.csproj" />
        <ProjectReference Include="..\..\..\Secrets.AzureKeyVault\Secrets.AzureKeyVault.csproj" />
        <ProjectReference Include="..\..\..\Security\Security.csproj" />
        <ProjectReference Include="..\..\..\Telemetry\Telemetry.csproj" />
        <ProjectReference Include="..\..\..\WebApi.OpenApi\WebApi.OpenApi.csproj" />
        <ProjectReference Include="..\..\..\WebApi.Security\WebApi.Security.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Contracts\Contracts.csproj" />
        <ProjectReference Include="..\Domain\Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="logs\" />
    </ItemGroup>
</Project>
