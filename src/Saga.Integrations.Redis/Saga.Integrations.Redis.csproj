<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <PackageId>Genocs.Saga.Integrations.Redis</PackageId>
        <AssemblyName>Genocs.Saga.Integrations.Redis</AssemblyName>
        <PackageId>Genocs.Saga.Integrations.Redis</PackageId>
        <Title>Genocs Redis saga integration</Title>
        <Description>Redis storage integration for Genocs saga state management.</Description>
        <PackageTags>genocs saga redis state-management orchestration</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="StackExchange.Redis" Version="3.4.5" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>Genocs.Saga.UnitTests</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Core\Core.csproj" />
        <ProjectReference Include="..\Saga\Saga.csproj" />
    </ItemGroup>

</Project>
