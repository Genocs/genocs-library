{
  "app": {
    "name": "Demo WebApi",
    "service": "demo_webapi",
    "instance": "1",
    "version": "v1.0",
    "displayBanner": true,
    "displayVersion": true
  },
  "logger": {
    "level": "debug",
    "excludePaths": [
      "/",
      "/healthz",
      "/alive",
      "/metrics"
    ],
    "excludeProperties": [
      "api_key",
      "access_key",
      "ApiKey",
      "ApiSecret",
      "ClientId",
      "ClientSecret",
      "ConnectionString",
      "Password",
      "Email",
      "Login",
      "Secret",
      "Token"
    ],
    "console": {
      "enabled": true
    },
    "file": {
      "enabled": true,
      "path": "logs/logs.txt",
      "interval": "day"
    },
    "seq": {
      "enabled": true,
      "url": "http://localhost:5341",
      "apiKey": null
    },
    "tags": {}
  },
  "telemetry": {
    "enabled": true,
    "exporter": {
      "enabled": false,
      "otlpEndpoint": "http://localhost:4317",
      "protocol": "Grpc",
      "processorType": "Batch",
      "maxQueueSize": 2048,
      "scheduledDelayMilliseconds": 5000,
      "exporterTimeoutMilliseconds": 30000,
      "maxExportBatchSize": 512
    },
    "console": {
      "enabled": false,
      "enableStructured": false,
      "enableTracing": false,
      "enableMetrics": false
    },
    "azure": {
      "enabled": false,
      "enableTracing": false,
      "enableMetrics": false,
      "connectionString": "<<your_app_insights_connection_string_here>>"
    },
    "prometheus": {
      "enabled": true,
      "endpoint": "/metrics"
    },
    "enableWildcardActivitySources": false,
    "activitySources": [ "*" ]
  },
  "redis": {
    "enabled": true,
    "configuration": "localhost:6379",
    "instance": "demo_webapi",
    "database": 1
  },
  "rabbitmq": {
    "connectionName": "demo_webapi",
    "messagesPersisted": true,
    "retries": 3,
    "retryInterval": 2,
    "conventionsCasing": "snakeCase",
    "logger": {
      "enabled": true,
      "logConnectionStatus": true,
      "logMessagePayload": true
    },
    "username": "guest",
    "password": "guest",
    "virtualHost": "/",
    "port": 5672,
    "hostnames": [
      "localhost",
      "rabbitmq"
    ],
    "requestedConnectionTimeout": "00:00:30",
    "requestedHeartbeat": "00:01:00",
    "socketReadTimeout": "00:00:30",
    "socketWriteTimeout": "00:00:30",
    "continuationTimeout": "00:00:20",
    "handshakeContinuationTimeout": "00:00:10",
    "networkRecoveryInterval": "00:00:05",
    "exchange": {
      "declare": true,
      "durable": true,
      "autoDelete": false,
      "type": "topic",
      "name": "demo"
    },
    "queue": {
      "declare": true,
      "durable": true,
      "exclusive": false,
      "autoDelete": false,
      "template": "{{assembly}}/{{exchange}}.{{message}}"
    },
    "context": {
      "enabled": true,
      "header": "message_context"
    },
    "spanContextHeader": "span_context",
    "deadLetter": {
      "enabled": true,
      "prefix": "dlx-",
      "declare": true
    },
    "maxProducerChannels": 1000
  },
  "mongoDb": {
    "connectionString": "mongodb://localhost:27017",
    "database": "genocs-demo",
    "enableTracing": true,
    "seed": false
  },
  "openapi": {
    "enabled": true,
    "reDocEnabled": true,
    "name": "Demo WebApi",
    "title": "Genocs Demo WebApi",
    "version": "v2",
    "description": "The Genocs demo WebApi. A simle version to show you genocs library in place.",
    "routePrefix": "swagger",
    "contactName": "Giovanni Nocco",
    "contactEmail": "giovanni.nocco@genocs.com",
    "contactUrl": "https://www.genocs.com",
    "licenseName": "Use under MIT",
    "licenseUrl": "https://opensource.org/license/mit",
    "termsOfService": "https://www.genocs.com/terms_and_conditions.html",
    "includeSecurity": true,
    "servers": [
      {
        "url": "https://localhost:5070",
        "description": "Local api to be used for development"
      }
    ]
  },
  "ConnectionStrings": {
    "BookStore": "Server=(localdb)\\MSSQLLocalDB;Database=Genocs.Microservice.Demo1;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Finbuckle:MultiTenant:Stores:ConfigurationStore": {
    "Tenants": [
      {
        "Id": "93f330717e5d4f039cd05da312d559cc",
        "Identifier": "gnx",
        "Name": "Genocs"
      }
    ]
  },
  "databaseOptions": {
    "dBProvider": "mssql",
    "connectionString": "Server=(localdb)\\MSSQLLocalDB;Database=Genocs.Microservice.Demo3;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "AllowedHosts": "*",
  "simmetric_jwt": {
    "enabled": true,
    "requireHttpsMetadata": false,
    "issuer": "genocs-identities-service",
    "issuerSigningKey": "THIS IS USED TO SIGN AND VERIFY JWT TOKENS, REPLACE IT WITH YOUR OWN SECRET, IT CAN BE ANY STRING",
    "validateIssuer": true,
    "validIssuer": "genocs-identities-service",
    "validateAudience": false,
    "validateLifetime": false,
    "requireExpirationTime": false,
    "requireSignedTokens": false,
    "validateIssuerSigningKey": false,
    "expiry": "01:00:00",
    "saveToken": true
  }
}