<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Genocs.Library.Demo.WebApi</RootNamespace>
        <AssemblyName>Genocs.Library.Demo.WebApi</AssemblyName>
        <IsPackable>false</IsPackable>
        <UserSecretsId>Genocs</UserSecretsId>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <DockerfileContext>..\..</DockerfileContext>
        <!-- Disable web.config transformation for Docker builds -->
        <TransformWebConfigEnabled>false</TransformWebConfigEnabled>
        <WebConfigTransformEnabled>false</WebConfigTransformEnabled>
    </PropertyGroup>


    <ItemGroup>
        <PackageReference Include="Genocs.Auth" Version="9.0.0" />
        <PackageReference Include="Genocs.Logging" Version="9.0.0" />
        <PackageReference Include="Genocs.Messaging" Version="9.0.0" />
        <PackageReference Include="Genocs.Messaging.Outbox" Version="9.0.0" />
        <PackageReference Include="Genocs.Messaging.Outbox.MongoDB" Version="9.0.0" />
        <PackageReference Include="Genocs.Messaging.RabbitMQ" Version="9.0.0" />
        <PackageReference Include="Genocs.Telemetry" Version="9.0.0" />
        <PackageReference Include="Genocs.Saga" Version="9.0.0" />
        <PackageReference Include="Genocs.Saga.Integrations.MongoDB" Version="9.0.0" />
        <PackageReference Include="Genocs.Saga.Integrations.Redis" Version="9.0.0" />
        <PackageReference Include="Genocs.WebApi.OpenApi" Version="9.0.0" />
    </ItemGroup>    

    <ItemGroup>
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Contracts\Contracts.csproj" />
        <ProjectReference Include="..\Domain.EFCore\Domain.EFCore.csproj" />
        <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
        <ProjectReference Include="..\Domain\Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="HealthChecks\" />
    </ItemGroup>

</Project>
