<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Genocs.Library.Demo.Masstransit.WebApi</RootNamespace>
        <AssemblyName>Genocs.Library.Demo.Masstransit.WebApi</AssemblyName>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>Genocs</UserSecretsId>
        <IsPackable>false</IsPackable>
        <!-- Disable web.config transformation for Docker builds -->
        <TransformWebConfigEnabled>false</TransformWebConfigEnabled>
        <WebConfigTransformEnabled>false</WebConfigTransformEnabled>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MassTransit.RabbitMQ" Version="[8.5.8]" />
    </ItemGroup>


    <ItemGroup>
        <PackageReference Include="Genocs.Auth" Version="9.0.1" />
        <PackageReference Include="Genocs.Logging" Version="9.0.0" />
        <PackageReference Include="Genocs.Telemetry" Version="9.0.0" />
        <PackageReference Include="Genocs.Http" Version="9.0.0" />
        <PackageReference Include="Genocs.Messaging.RabbitMQ" Version="9.0.0" />
        <PackageReference Include="Genocs.Security" Version="9.0.1" />
        <PackageReference Include="Genocs.WebApi.OpenApi" Version="9.0.0" />
        <PackageReference Include="Genocs.WebApi.Security" Version="9.0.0" />
        <PackageReference Include="Genocs.Secrets.AzureKeyVault" Version="9.0.0" />
    </ItemGroup>    

    <ItemGroup>
        <ProjectReference Include="..\Contracts\Contracts.csproj" />
        <ProjectReference Include="..\Domain\Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="logs\" />
    </ItemGroup>
</Project>
