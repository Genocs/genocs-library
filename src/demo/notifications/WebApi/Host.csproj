<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Genocs.Notifications.WebApi</RootNamespace>
        <AssemblyName>Genocs.Notifications.WebApi</AssemblyName>
        <IsPackable>false</IsPackable>
        <UserSecretsId>Genocs</UserSecretsId>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <DockerfileContext>..\..</DockerfileContext>
        <!-- Disable web.config transformation for Docker builds -->
        <TransformWebConfigEnabled>false</TransformWebConfigEnabled>
        <WebConfigTransformEnabled>false</WebConfigTransformEnabled>
        <SignalRClientProjectDir>$(MSBuildProjectDirectory)\signalr-client</SignalRClientProjectDir>
        <EnableSignalRClientBuild Condition="'$(EnableSignalRClientBuild)' == ''">true</EnableSignalRClientBuild>
    </PropertyGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <ProjectReference Include="..\..\..\Genocs.Auth\Genocs.Auth.csproj" />
        <ProjectReference Include="..\..\..\Genocs.Http\Genocs.Http.csproj" />
        <ProjectReference Include="..\..\..\Genocs.LoadBalancing.Fabio\Genocs.LoadBalancing.Fabio.csproj" />
        <ProjectReference Include="..\..\..\Genocs.Logging\Genocs.Logging.csproj" />
        <ProjectReference Include="..\..\..\Genocs.Messaging\Genocs.Messaging.csproj" />
        <ProjectReference Include="..\..\..\Genocs.Messaging.Outbox.MongoDB\Genocs.Messaging.Outbox.MongoDB.csproj" />
        <ProjectReference Include="..\..\..\Genocs.Messaging.Outbox\Genocs.Messaging.Outbox.csproj" />
        <ProjectReference Include="..\..\..\Genocs.Messaging.RabbitMQ\Genocs.Messaging.RabbitMQ.csproj" />
        <ProjectReference Include="..\..\..\Genocs.Persistence.MongoDB\Genocs.Persistence.MongoDB.csproj" />
        <ProjectReference Include="..\..\..\Genocs.Persistence.Redis\Genocs.Persistence.Redis.csproj" />
        <ProjectReference Include="..\..\..\Genocs.Secrets.HashicorpKeyVault\Genocs.Secrets.HashicorpKeyVault.csproj" />
        <ProjectReference Include="..\..\..\Genocs.Telemetry\Genocs.Telemetry.csproj" />
        <ProjectReference Include="..\..\..\Genocs.WebApi.CQRS\Genocs.WebApi.CQRS.csproj" />
        <ProjectReference Include="..\..\..\Genocs.WebApi.Security\Genocs.WebApi.Security.csproj" />
        <ProjectReference Include="..\..\..\Genocs.WebApi.OpenApi\Genocs.WebApi.OpenApi.csproj" />
        <ProjectReference Include="..\..\..\Genocs.WebApi\Genocs.WebApi.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Release'">
        <PackageReference Include="Genocs.Auth" Version="9.0.0-beta008" />
        <PackageReference Include="Genocs.Http" Version="9.0.0-beta008" />
        <PackageReference Include="Genocs.LoadBalancing.Fabio" Version="9.0.0-beta008" />
        <PackageReference Include="Genocs.Logging" Version="9.0.0-beta008" />
        <PackageReference Include="Genocs.Messaging" Version="9.0.0-beta008" />
        <PackageReference Include="Genocs.Messaging.Outbox.MongoDB" Version="9.0.0-beta008" />
        <PackageReference Include="Genocs.Messaging.Outbox" Version="9.0.0-beta008" />
        <PackageReference Include="Genocs.Messaging.RabbitMQ" Version="9.0.0-beta008" />
        <PackageReference Include="Genocs.Persistence.MongoDB" Version="9.0.0-beta008" />
        <PackageReference Include="Genocs.Persistence.Redis" Version="9.0.0-beta008" />
        <PackageReference Include="Genocs.Secrets.HashicorpKeyVault" Version="9.0.0-beta008" />
        <PackageReference Include="Genocs.Telemetry" Version="9.0.0-beta008" />
        <PackageReference Include="Genocs.WebApi.CQRS" Version="9.0.0-beta008" />
        <PackageReference Include="Genocs.WebApi.Security" Version="9.0.0-beta008" />
        <PackageReference Include="Genocs.WebApi.OpenApi" Version="9.0.0-beta008" />
        <PackageReference Include="Genocs.WebApi" Version="9.0.0-beta008" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Azure.Messaging.EventHubs" Version="5.12.2" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="certs\**" CopyToPublishDirectory="Always" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="logs\" />
    </ItemGroup>

    <Target Name="BuildSignalRClient" BeforeTargets="Build;Publish" Condition="'$(EnableSignalRClientBuild)' == 'true' and Exists('$(SignalRClientProjectDir)\package.json')">
        <Message Text="Building SignalR React client..." Importance="high" />
        <Exec Command="npm ci" WorkingDirectory="$(SignalRClientProjectDir)" Condition="Exists('$(SignalRClientProjectDir)\package-lock.json')" />
        <Exec Command="npm install" WorkingDirectory="$(SignalRClientProjectDir)" Condition="!Exists('$(SignalRClientProjectDir)\package-lock.json')" />
        <Exec Command="npm run build" WorkingDirectory="$(SignalRClientProjectDir)" />
    </Target>
</Project>