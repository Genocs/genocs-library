<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Genocs.Orders.WebApi</RootNamespace>
        <AssemblyName>Genocs.Orders.WebApi</AssemblyName>
        <IsPackable>false</IsPackable>
        <UserSecretsId>Genocs</UserSecretsId>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <DockerfileContext>..\..</DockerfileContext>
        <!-- Disable web.config transformation for Docker builds -->
        <TransformWebConfigEnabled>false</TransformWebConfigEnabled>
        <WebConfigTransformEnabled>false</WebConfigTransformEnabled>
    </PropertyGroup>


    <ItemGroup>
        <PackageReference Include="Genocs.Http" Version="9.0.0" />
        <PackageReference Include="Genocs.LoadBalancing.Fabio" Version="9.0.0" />
        <PackageReference Include="Genocs.Logging" Version="9.0.0" />
        <PackageReference Include="Genocs.Messaging" Version="9.0.0" />
        <PackageReference Include="Genocs.Messaging.Outbox" Version="9.0.0" />
        <PackageReference Include="Genocs.Messaging.Outbox.MongoDB" Version="9.0.0" />
        <PackageReference Include="Genocs.Messaging.RabbitMQ" Version="9.0.0" />
        <PackageReference Include="Genocs.Persistence.MongoDB" Version="9.0.0" />
        <PackageReference Include="Genocs.Persistence.Redis" Version="9.0.0" />
        <PackageReference Include="Genocs.Secrets.HashicorpKeyVault" Version="9.0.0" />
        <PackageReference Include="Genocs.Telemetry" Version="9.0.0" />
        <PackageReference Include="Genocs.WebApi.CQRS" Version="9.0.0" />
        <PackageReference Include="Genocs.WebApi.Security" Version="9.0.0" />
        <PackageReference Include="Genocs.WebApi.OpenApi" Version="9.0.0" />
        <PackageReference Include="Genocs.WebApi" Version="9.0.0" />
    </ItemGroup>    

    <ItemGroup>
        <Folder Include="logs\" />
    </ItemGroup>

</Project>
