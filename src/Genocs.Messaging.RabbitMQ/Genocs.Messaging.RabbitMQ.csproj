<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <PackageId>Genocs.Messaging.RabbitMQ</PackageId>
        <RootNamespace>Genocs.Messaging.RabbitMQ</RootNamespace>
        <AssemblyName>Genocs.Messaging.RabbitMQ</AssemblyName>
        <Title>Genocs RabbitMQ messaging integration</Title>
        <Description>RabbitMQ integration for Genocs messaging abstractions.</Description>
        <PackageTags>genocs messaging rabbitmq amqp integration</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Genocs.Messaging\Genocs.Messaging.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="Polly" Version="8.7.0" />
        <PackageReference Include="RabbitMQ.Client" Version="7.2.1" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Genocs.Messaging.RabbitMQ.UnitTests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>


</Project>
