<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <PackageId>Genocs.WebApi.Security</PackageId>
        <RootNamespace>Genocs.WebApi.Security</RootNamespace>
        <AssemblyName>Genocs.WebApi.Security</AssemblyName>
        <Title>Genocs Web API security support</Title>
        <Description>Security extensions for authentication and authorization in Genocs Web APIs.</Description>
        <PackageTags>genocs webapi security authentication authorization aspnetcore</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.Certificate" Version="10.0.11" Condition="'$(TargetFramework)' == 'net10.0'" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.Certificate" Version="9.0.19" Condition="'$(TargetFramework)' == 'net9.0'" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.Certificate" Version="8.0.30" Condition="'$(TargetFramework)' == 'net8.0'" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Genocs.Core\Genocs.Core.csproj" />
    </ItemGroup>

</Project>
