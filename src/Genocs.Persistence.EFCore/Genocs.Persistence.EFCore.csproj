<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <PackageId>Genocs.Persistence.EFCore</PackageId>
        <RootNamespace>Genocs.Persistence.EFCore</RootNamespace>
        <AssemblyName>Genocs.Persistence.EFCore</AssemblyName>
        <Title>Genocs EF Core persistence integration</Title>
        <Description>EF Core repository and persistence integration for Genocs applications.</Description>
        <PackageTags>genocs persistence efcore entity-framework repository data-access</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Ardalis.Specification.EntityFrameworkCore" Version="9.3.1" />
        <PackageReference Include="Dapper" Version="2.1.79" />
        <PackageReference Include="Mapster" Version="10.0.11" />
        <PackageReference Include="MediatR" Version="14.2.0" />
        <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup Label="EF Core">
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" Condition="'$(TargetFramework)' == 'net10.0'" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.15" Condition="'$(TargetFramework)' == 'net9.0'" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.26" Condition="'$(TargetFramework)' == 'net8.0'" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Genocs.Core\Genocs.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Genocs.Persistence.EFCore.UnitTests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
