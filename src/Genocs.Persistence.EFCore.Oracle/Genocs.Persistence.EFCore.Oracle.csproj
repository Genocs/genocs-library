<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <PackageId>Genocs.Persistence.EFCore.Oracle</PackageId>
        <RootNamespace>Genocs.Persistence.EFCore.Oracle</RootNamespace>
        <AssemblyName>Genocs.Persistence.EFCore.Oracle</AssemblyName>
        <Title>Genocs EF Core Oracle provider</Title>
        <Description>Oracle database provider for Genocs EF Core persistence.</Description>
        <PackageTags>genocs persistence efcore entity-framework oracle data-access</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Genocs.Persistence.EFCore\Genocs.Persistence.EFCore.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Oracle.EntityFrameworkCore" Version="10.23.26200" Condition="'$(TargetFramework)' == 'net10.0'" />
        <PackageReference Include="Oracle.EntityFrameworkCore" Version="9.23.26200" Condition="'$(TargetFramework)' == 'net9.0'" />
        <PackageReference Include="Oracle.EntityFrameworkCore" Version="8.23.26200" Condition="'$(TargetFramework)' == 'net8.0'" />
    </ItemGroup>

</Project>
